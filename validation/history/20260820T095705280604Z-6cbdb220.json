  "claims": [
    {
      "claim_digest": "6ad28d83afa31e735cb7ad07cec8842e85ed00726095ed28af9f9877202b4788",
      "claim_id": "claim:read-only-interface",
      "element_ref": {
        "component_id": "public-skill-interface",
        "element_id": "routing-install-and-boundaries"
      },
      "material": true,
      "rationale": "The skill and public boundary are explicit, and the local structural suite passes.",
      "statement": "Server Ops 0.1.1 presents a local, non-production, read-only skill interface and does not advertise a certified mutation provider.",
      "status": "supported"
    },
    {
      "claim_digest": "9f7e7b94b9fc451fd1932beff5e6dccd67e26c7b6b5ab73aec128c672b2108ed",
      "claim_id": "claim:strict-adapter-health",
      "element_ref": {
        "component_id": "read-only-runtime",
        "element_id": "strict-adapter-and-health"
      },
      "material": true,
      "rationale": "Implementation inspection and the passing adapter/health tests support this bounded statement.",
      "statement": "In the tested cases, adapters fail closed and health probes are credential-free literal-loopback HTTP with bounded, redirect-free exact-predicate behavior.",
      "status": "supported"
    },
    {
      "claim_digest": "1bb2df5a1e85feae9dff1281c17c630713aa4dfef59d15328ae635fd333ee7cc",
      "claim_id": "claim:discovery-and-refusal",
      "element_ref": {
        "component_id": "read-only-runtime",
        "element_id": "bounded-discovery-and-mutation-refusal"
      },
      "material": true,
      "rationale": "The discovery/planner sources and passing subprocess, receipt, and refusal tests directly cover this host-bounded claim.",
      "statement": "On the current Windows candidate, listener discovery is bounded to exact-workspace candidates, public output redacts raw process arguments, and uncertified lifecycle requests return integrity-checked refusal receipts without process mutation in the tested cases.",
      "status": "supported"
    },
    {
      "claim_digest": "9e9223bdd0db41608741b81f92a3a340eb1c3e5fd22683f5c65b7ddf51e46e64",
      "claim_id": "claim:package-origin-integrity",
      "element_ref": {
        "component_id": "managed-package-lifecycle",
        "element_id": "package-origin-and-integrity"
      },
      "material": true,
      "rationale": "The manifest verifier, official validator, and origin-negative regression tests pass locally.",
      "statement": "The release-candidate package has synchronized version identity and a bounded no-follow verified manifest that permits only the expected Ian-Tseng/server-ops GitHub source metadata in the tested cases.",
      "status": "supported"
    },
    {
      "claim_digest": "581090919c9f3f8931ee351496304a2a8099419bf84e4f64f0efb2c7a6cf89c7",
      "claim_id": "claim:managed-install-default-off",
      "element_ref": {
        "component_id": "managed-package-lifecycle",
        "element_id": "verified-install-and-default-off-privacy"
      },
      "material": true,
      "rationale": "Installer tests and static source inspection pass; absence of every possible dependency network path was not established by packet interception.",
      "statement": "On tested temporary registries, the custom installer fails closed on unsafe or modified state and no lifecycle analytics, reporting, feedback, or update transport is enabled by default.",
      "status": "partially_supported"
    },
    {
      "claim_digest": "a0dfa2f82141dcfe3fba0b926599f2f2e189fb9120961616fe8f61336c94ccf1",
      "claim_id": "claim:local-candidate-only",
      "element_ref": {
        "component_id": "release-evidence-and-provenance",
        "element_id": "local-release-candidate-authority"
      },
      "material": true,
      "rationale": "The release receipt records only completed local gates and explicitly lists every pending remote gate.",
      "statement": "Version 0.1.1 is locally ready for PR publication gates, but remote CI, public release, consumer installation, and live client activation are not yet verified.",
      "status": "supported"
    },
    {
      "claim_digest": "2ad954440d65d53d4720769ed5ccfa0673b3d5e6f5a4e0ed29499e8ea9f96310",
      "claim_id": "claim:cross-platform-runtime",
      "element_ref": {
        "component_id": "read-only-runtime",
        "element_id": "bounded-discovery-and-mutation-refusal"
      },
      "material": true,
      "rationale": "The public matrix has not run yet; local execution covers Windows only.",
      "statement": "Server Ops 0.1.1 behaves correctly on Linux and macOS.",
      "status": "untested"
    }
  ],
